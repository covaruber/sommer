> ### Name: strm
> ### Title: Covariance structure spanning several random terms
> ### Aliases: strm
> ### Keywords: models
> 
> ### ** Examples
> 
> set.seed(3)
> ids <- paste0("i", 1:30)
> A <- diag(30) + diag(0.2, 30); dimnames(A) <- list(ids, ids)
> Ai <- solve(A); attr(Ai, "inverse") <- TRUE
> d <- data.frame(id = factor(sample(ids, 200, TRUE), levels = ids),
+                 dam = factor(sample(ids[1:15], 200, TRUE), levels = ids))
> d$y <- rnorm(200)
> fit <- mmes(y ~ 1,
+   random = ~ strm(dir = vsm(ism(id)), mat = vsm(ism(dam)), Gu = Ai),
+   data = d,
+   control = mmes_control(diagnostics = list(verbose = FALSE)))
> covparams_mmes(fit, 1)
                                                    term        factor section
1 strm(dir = vsm(ism(id)), mat = vsm(ism(dam)), Gu = Ai) strm(dir,mat)    <NA>
2 strm(dir = vsm(ism(id)), mat = vsm(ism(dam)), Gu = Ai) strm(dir,mat)    <NA>
3 strm(dir = vsm(ism(id)), mat = vsm(ism(dam)), Gu = Ai) strm(dir,mat)    <NA>
            parameter   estimate
1       variance[dir] 0.01034899
2 covariance[mat,dir] 0.01939487
3       variance[mat] 0.03634795
> 
> 
