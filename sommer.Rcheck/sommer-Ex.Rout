> ### Name: vcc
> ### Title: Equality and scaling constraints between variance parameters
> ### Aliases: vcc vcParams
> ### Keywords: models
> 
> ### ** Examples
> 
> data(DT_yatesoats, package = "enhancer")
> DT <- DT_yatesoats
> p <- mmes(Y ~ V * N,
+   random = ~ B + B:MP,
+   rcov = ~ units,
+   data = DT,
+   control = mmes_control(output = list(setup = TRUE)))
> p$vcParams
  index            term parameter  kind    start free structure position
1     1     vsm(ism(B))    sigma2 scale 246.9339 TRUE         1        1
2     2  vsm(ism(B:MP))    sigma2 scale 248.8111 TRUE         2        1
3     3 vsm(ism(units))    sigma2 scale 248.8111 TRUE         3        1
> # block and whole-plot variances equal
> m1 <- mmes(Y ~ V * N,
+   random = ~ B + B:MP,
+   rcov = ~ units,
+   data = DT,
+   vcc = data.frame(parameter = c(1, 2), group = 1),
+   control = mmes_control(diagnostics = list(verbose = FALSE)))
> # block variance twice the whole-plot variance
> m2 <- mmes(Y ~ V * N,
+   random = ~ B + B:MP,
+   rcov = ~ units,
+   data = DT,
+   vcc = data.frame(parameter = c("vsm(ism(B:MP)):sigma2", "vsm(ism(B)):sigma2"),
+                             group = 1, scale = c(1, 2)),
+   control = mmes_control(diagnostics = list(verbose = FALSE)))
> unlist(m2$covPar)
    vsm(ism(B))  vsm(ism(B:MP)) vsm(ism(units)) 
       213.0828        106.5414        177.0522 
> 
