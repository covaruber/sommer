PKG_CPPFLAGS = @SOMMER_METIS_CPPFLAGS@ @SOMMER_CUDA_CPPFLAGS@

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)

PKG_LIBS = \
	$(SHLIB_OPENMP_CXXFLAGS) \
	$(LAPACK_LIBS) \
	$(BLAS_LIBS) \
	$(FLIBS) \
@SOMMER_METIS_LIBS@ @SOMMER_CUDA_LIBS@ @SOMMER_GPU_LOADER_LIBS@

all: $(SHLIB)

MNR.o: mme_paths.h mme_factors.h mme_covariance.h mme_sp2_support.h
ai_mme_sp2.o: mme_paths.h mme_factors.h mme_covariance.h mme_sp2_support.h mme_gpu.h mme_cuda_runtime.h
mme_gpu.o: mme_gpu.h mme_cuda_runtime.h