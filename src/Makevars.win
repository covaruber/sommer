
## With R 3.1.0 or later, you can uncomment the following line to tell R to
## enable compilation with C++11 (where available)
##
## Also, OpenMP support in Armadillo prefers C++11 support. However, for wider
## availability of the package we do not yet enforce this here.  It is however
## recommended for client packages to set it.
##
## And with R 3.4.0, and RcppArmadillo 0.7.960.*, we turn C++11 on as OpenMP
## support within Armadillo prefers / requires it
## CXX_STD = CXX11

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
PKG_CPPFLAGS = -DARMA_64BIT_WORD=1

all: $(SHLIB)

native_utils.o native_relationships.o mme_inference.o mme_direct.o mme_solve.o: mme_sp2_support.h mme_control.h mme_control_r.h mme_paths.h mme_factors.h mme_covariance.h mme_progress.h
mme_direct.o: mme_direct_em.h mme_em_optimizer.h mme_recovery.h mme_ai_recovery.h
mme_direct.o mme_solve.o: mme_direct_covariance.h
MNR.o ai_mme_sp2.o: mme_control.h mme_control_r.h
MNR.o: mme_paths.h mme_factors.h mme_covariance.h mme_sp2_support.h mme_progress.h
ai_mme_sp2.o: mme_paths.h mme_factors.h mme_covariance.h mme_sp2_support.h mme_gpu.h mme_cuda_runtime.h mme_rr.h mme_saddle.h mme_exact.h mme_em.h mme_em_optimizer.h mme_recovery.h mme_sparse.h mme_cholmod.h mme_posterior.h mme_progress.h mme_ai_recovery.h mme_pcg.h mme_pcg_estimators.h mme_sufficient.h
ai_mme_sp2.o: mme_pcg_recycle.h
ai_mme_sp2.o: mme_scale.h
ai_mme_sp2.o: mme_layout.h
mme_gpu.o: mme_gpu.h mme_cuda_runtime.h
